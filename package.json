{
  "name": "cli-manager",
  "version": "0.1.0",
  "description": "通用命令行工具管理器 - 统一发现、安装、更新、配置和卸载系统中所有的 CLI 工具",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "cli-manager": "dist/index.js"
  },
  "scripts": {
    "prebuild": "node scripts/bundle-html.js",
    "build": "pnpm prebuild && tsup src/index.ts --format esm --out-dir dist --clean --dts",
    "dev": "tsup src/index.ts --format esm --out-dir dist --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "better-sqlite3": "^11.0.0",
    "blessed": "^0.1.81",
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.5",
    "commander": "^12.1.0",
    "js-yaml": "^4.2.0",
    "ora": "^8.1.0",
    "semver": "^7.6.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "@types/semver": "^7.5.8",
    "tsup": "^8.3.0",
    "typescript": "~5.5.0",
    "vitest": "^2.1.0"
  },
  "keywords": [
    "cli",
    "manager",
    "tool",
    "package-manager"
  ],
  "license": "MIT"
}
